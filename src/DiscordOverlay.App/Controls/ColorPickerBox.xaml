<UserControl x:Class="DiscordOverlay.App.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="SwatchButton"
                Width="44" Height="32" Padding="0"
                Click="OnSwatchClick"
                ToolTip="{Binding PickerToolTip, ElementName=Root}">
            <Border x:Name="Swatch" CornerRadius="3" Width="30" Height="18" />
        </Button>

        <ui:TextBox x:Name="HexBox"
                    Width="104" Margin="8,0,0,0"
                    MaxLength="7"
                    TextChanged="OnHexTextChanged"
                    VerticalAlignment="Center" />

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=SwatchButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,4,0,0"
                    Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Direction="270" />
                </Border.Effect>

                <!-- The library's SquarePicker (hue ring + saturation/value square)
                     and nothing else. Its StandardColorPicker wraps this in a hex
                     field and HSV/HSL/RGB spin boxes whose right-hand column
                     clips at every width tried, 230 through 380 — a layout bug in
                     the control, not a sizing mistake here. We already have a hex
                     box above, so the broken half is no loss. -->
                <StackPanel>
                    <cp:SquarePicker x:Name="Picker"
                                     Width="248" Height="248"
                                     SmallChange="1"
                                     ColorChanged="OnPickerColorChanged" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
